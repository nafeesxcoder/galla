{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "myGallaBook",
  "version": "1.0.0",
  "identifier": "com.mygallabook.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:8081",
    "beforeDevCommand": "npm run web",
    "beforeBuildCommand": "npm run export:web"
  },
  "app": {
    "windows": [
      {
        "title": "myGallaBook",
        "width": 1100,
        "height": 780,
        "minWidth": 380,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis", "dmg", "app", "deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "GST billing for your shop",
    "longDescription": "Make GST bills, keep stock, and know who owes you money.",
    "copyright": "",
    "category": "Business",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"]
      }
    }
  }
}
