# ===========================================================================
# GALLA BACKEND - ENVIRONMENT
# ---------------------------------------------------------------------------
# Copy to .env and fill in. .env is gitignored and must stay that way.
# ===========================================================================

NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# Where the website runs, for CORS. Comma separated for more than one.
CORS_ORIGINS=http://localhost:3000

# --- database --------------------------------------------------------------
# Create the database first - the migrations create tables, not the database.
#   CREATE DATABASE galla CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=galla
DB_PASSWORD=
DB_NAME=galla
DB_POOL_MIN=2
DB_POOL_MAX=10

# --- tokens ----------------------------------------------------------------
# Generate a real one:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# The app REFUSES TO START in production if this is missing or under 32 chars.
JWT_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
JWT_ISSUER=galla-api

# --- one-time passwords ----------------------------------------------------
OTP_LENGTH=6
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_MAX_PER_HOUR=5

# Returns the OTP in the API response so you can build without SMS working.
# FORCED OFF when NODE_ENV=production - the config overrides it, there is no
# way to turn it on there, and there should not be.
OTP_ECHO=true

# --- SMS -------------------------------------------------------------------
# Leave blank until you have a provider. Until then OTPs are only logged.
#
# Sending an OTP in India needs more than an API key: the sender ID and the
# message template both have to be registered under TRAI's DLT rules first.
# That takes days to weeks and nothing can be tested without it, so start the
# registration before you need it.
SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER_ID=
SMS_TEMPLATE_ID=
