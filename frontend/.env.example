# ===========================================================================
# GALLA - ENVIRONMENT VARIABLES
# ---------------------------------------------------------------------------
# Copy this file to .env.local for local work:
#
#     copy .env.example .env.local
#
# For the live site, put the same values in Vercel under
# Settings -> Environment Variables. Never commit .env.local - it is already
# in .gitignore.
# ===========================================================================

# --- the site's own address ------------------------------------------------
# Every canonical tag, the sitemap and the social preview tags are built from
# this. Set it once the real domain is decided. Leave it out and the fallback
# in lib/seo.js is used.
NEXT_PUBLIC_SITE_URL=https://example.com

# --- sending mail from the contact and careers forms -----------------------
# Sign up at resend.com, create an API key, and verify your domain.
# Until all three of these are set, the forms tell visitors to email you
# directly instead of pretending the message went through.
RESEND_API_KEY=
MAIL_FROM=Galla <noreply@example.com>
MAIL_TO=you@example.com
