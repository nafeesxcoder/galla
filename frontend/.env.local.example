# ===========================================================================
# THE WEBSITE'S ENVIRONMENT
# ---------------------------------------------------------------------------
# Copy to .env.local in the SAME folder as package.json. Restart npm run dev
# afterwards - Next reads these at boot, not on reload.
# ===========================================================================

# Where the backend is. NEXT_PUBLIC_ means the browser can see it, which it
# has to, because the browser is what calls the API.
#
# Local:  http://localhost:4000
# Live:   https://api.yourdomain.com
NEXT_PUBLIC_API_URL=http://localhost:4000

# The website's own address, for canonical tags and the sitemap. Set this in
# Vercel once the domain is decided.
# NEXT_PUBLIC_SITE_URL=https://yourdomain.com
