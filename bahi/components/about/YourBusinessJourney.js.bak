import Reveal from "@/components/Reveal";

export default function YourBusinessJourney({ journey }) {
  return (
    <section className="section">
      <div className="wrap">
        <Reveal className="center">
          <span className="eyebrow">{journey.eyebrow}</span>
          <h2>{journey.h2}</h2>
          <p className="lead">{journey.lead}</p>
        </Reveal>

        <ol className="ab-journey">
          {journey.items.map((it, i) => (
            <Reveal as="li" key={it.no} delay={i * 90} className="ab-journey__item">
              <span className="ab-journey__no">{it.no}</span>
              <span className="ab-journey__time">{it.time}</span>
              <h3>{it.h3}</h3>
              <p>{it.p}</p>
              <span className="ab-journey__tag">{it.tag}</span>
            </Reveal>
          ))}
        </ol>
      </div>
    </section>
  );
}
