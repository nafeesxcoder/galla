import Reveal from "@/components/Reveal";
import MenuIcon from "@/components/MenuIcon";
import Shot from "./Shot";

export default function SmartGstBillingForGrowingBusinesses({ growth }) {
  return (
    <section className="section section--wash">
      <div className="wrap">
        <Reveal className="center">
          <span className="eyebrow">{growth.eyebrow}</span>
          <h2>{growth.h2}</h2>
          <p className="lead">{growth.lead}</p>
        </Reveal>

        <div className="ab-growth">
          <div className="ab-growth__list">
            {growth.items.map((it, i) => (
              <Reveal key={it.h3} delay={i * 90}>
                <article className="ab-growth__item">
                  <span className="fcard__icon">
                    <MenuIcon name={it.icon} />
                  </span>
                  <div>
                    <span className="ab-growth__tag">{it.tag}</span>
                    <h3>{it.h3}</h3>
                    <p>{it.p}</p>
                  </div>
                </article>
              </Reveal>
            ))}
          </div>

          <Reveal className="ab-growth__art" delay={160}>
            <Shot src={growth.img} label={growth.imgLabel} alt={growth.h2} />
          </Reveal>
        </div>
      </div>
    </section>
  );
}
