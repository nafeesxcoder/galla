import Link from "next/link";
import Reveal from "@/components/Reveal";
import Shot from "./Shot";

export default function ManageYourBusinessWithOurApp({ app }) {
  return (
    <section className="section section--wash">
      <div className="wrap artsplit artsplit--flip">
        <Reveal className="artsplit__art">
          <Shot src={app.img} label={app.imgLabel} alt={app.h2} />
        </Reveal>

        <Reveal delay={140}>
          <span className="eyebrow">{app.eyebrow}</span>
          <h2>{app.h2}</h2>
          <p className="lead">{app.lead}</p>

          <ul className="ab-applist">
            {app.items.map(([t, d]) => (
              <li key={t}>
                <strong>{t}</strong>
                <span>{d}</span>
              </li>
            ))}
          </ul>

          <div className="btn-row">
            <Link href="/mobile-app" className="btn btn--primary">
              {app.cta}
            </Link>
          </div>
        </Reveal>
      </div>
    </section>
  );
}
