// ===========================================================================
// Shot - image slot
// ---------------------------------------------------------------------------
// Jab content.js me us section ka  img: ""  khali hai, yahan ek dashed
// placeholder box dikhega jisme label likha hoga.
// Jaise hi tum  img: "/kuch.png"  bhar doge, asli image aa jayegi.
// Image public/ folder me rakhni hai.
// ===========================================================================

export default function Shot({ src, alt = "", label = "Image", className = "" }) {
  if (src) {
    // eslint-disable-next-line @next/next/no-img-element
    return <img src={src} alt={alt || label} className={`ab-shot__img ${className}`} loading="lazy" />;
  }

  return (
    <div className={`ab-shot ${className}`} role="img" aria-label={label}>
      <span className="ab-shot__mark" aria-hidden="true" />
      <span className="ab-shot__txt">{label}</span>
    </div>
  );
}
