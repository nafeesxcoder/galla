import Link from "next/link";
import Reveal from "@/components/Reveal";
import MenuIcon from "@/components/MenuIcon";

export default function OneBillingSoftwareAcrossIndustries({ everyType }) {
  return (
    <section className="section">
      <div className="wrap">
        <Reveal className="center">
          <span className="eyebrow">{everyType.eyebrow}</span>
          <h2>{everyType.h2}</h2>
          <p className="lead">{everyType.lead}</p>
        </Reveal>

        <div className="fgrid" style={{ gridTemplateColumns: "repeat(auto-fit, minmax(260px, 1fr))" }}>
          {everyType.items.map((it, i) => (
            <Reveal key={it.h3} delay={i * 90}>
              <article className="fcard">
                <span className="fcard__icon">
                  <MenuIcon name={it.icon} />
                </span>
                <h3>{it.h3}</h3>
                <p>{it.p}</p>
                <Link href={it.link[1]} className="ab-link">
                  {it.link[0]} <span aria-hidden="true">&rarr;</span>
                </Link>
              </article>
            </Reveal>
          ))}
        </div>
      </div>
    </section>
  );
}
