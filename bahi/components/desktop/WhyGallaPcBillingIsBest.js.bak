// ===========================================================================
// SECTION 3  -  "Why Galla PC Billing Software Is the Right Choice..."
// Comparison table (aam software vs Galla)
// IMAGE: koi nahi
// ===========================================================================

import Reveal from "@/components/Reveal";

export default function WhyGallaPcBillingIsBest({ compare }) {
  return (
    <section className="section section--wash">
      <div className="wrap">
        <Reveal className="center">
          <span className="eyebrow">{compare.eyebrow}</span>
          <h2>{compare.h2}</h2>
          <p className="lead">{compare.lead}</p>
        </Reveal>

        <Reveal delay={120}>
          <div className="table-wrap">
            <table className="compare dk-compare">
              <thead>
                <tr>
                  {compare.head.map((h, i) => (
                    <th key={h} className={i === compare.head.length - 1 ? "dk-compare__win" : undefined}>
                      {h}
                    </th>
                  ))}
                </tr>
              </thead>
              <tbody>
                {compare.rows.map((r) => (
                  <tr key={r[0]}>
                    {r.map((c, i) => (
                      <td key={i} className={i === r.length - 1 ? "dk-compare__win" : undefined}>
                        {c}
                      </td>
                    ))}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </Reveal>
      </div>
    </section>
  );
}
