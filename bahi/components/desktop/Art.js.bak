      <rect x="190" y="192" width="44" height="32" rx="4" fill="var(--marigold)" opacity=".3" stroke="var(--marigold)" strokeWidth="2.5" />
      <Lines x={258} y={128} widths={[58]} gap={0} w={5} />
      <Lines x={258} y={208} widths={[34]} gap={0} w={5} />
      <g className="art__float">
        <rect x="272" y="176" width="74" height="30" rx="15" fill="var(--marigold)" />
        <path d="M288 191h4M298 191h4M308 191h4" stroke="#fff" strokeWidth="4" strokeLinecap="round" />
        <path d="M326 184v8M326 197v.1" stroke="#fff" strokeWidth="4" strokeLinecap="round" />
      </g>
    </svg>
  );
}

/* --- 15. Orders --------------------------------------------------------- */
export function OrdersArt() {
  return (
    <svg className="art" viewBox="0 0 420 300" role="img" aria-label="Orders from booking to delivery">
      <circle className="art__blob" cx="346" cy="66" r="48" fill="var(--wash)" />
      <path d="M78 196h264" stroke="var(--wash)" strokeWidth="14" strokeLinecap="round" />
      {[
        [78, "var(--ledger)"],
        [166, "var(--ledger)"],
        [254, "var(--marigold)"],
        [342, "var(--ledger)"],
      ].map(([cx, fill], i) => (
        <g key={i}>
          <circle cx={cx} cy="196" r="20" fill={fill} opacity={i === 3 ? 0.25 : 1} />
          {i !== 3 && (
            <path d={`M${cx - 8} 196l6 7 11-13`} fill="none" stroke="#fff" strokeWidth="3.6" strokeLinecap="round" strokeLinejoin="round" />
          )}
        </g>
      ))}
      <g className="art__float">
        <rect x="140" y="44" width="150" height="110" rx="10" fill="#fff" stroke="var(--ink)" strokeWidth="3" />
        <rect x="140" y="44" width="150" height="26" rx="10" fill="var(--ledger)" />
        <Lines x={158} y={94} widths={[86, 108, 64]} gap={20} w={5} color="var(--ink)" />
      </g>
    </svg>
  );
}

/* --- 16. Demo video ----------------------------------------------------- */
export function PlayArt() {
  return (
    <svg className="art" viewBox="0 0 420 300" role="img" aria-label="Watch the demo">
      <circle className="art__blob" cx="352" cy="62" r="46" fill="var(--wash)" />
      <Monitor>
        <rect x="68" y="48" width="238" height="144" rx="6" fill="var(--ledger)" opacity=".12" />
        <Lines x={86} y={70} widths={[70]} gap={0} w={6} color="var(--ink)" />
      </Monitor>
      <circle className="art__pulse" cx="187" cy="124" r="44" fill="var(--marigold)" opacity=".3" />
      <g className="art__float">
        <circle cx="187" cy="124" r="34" fill="var(--ledger)" />
        <path d="M178 110l22 14-22 14z" fill="#fff" />
      </g>
    </svg>
  );
}

/* --- 17. Avatar (asli photo aane tak) ------------------------------------ */
export function AvatarArt({ initial = "G" }) {
  return (
    <svg className="art dk-avatar" viewBox="0 0 200 200" role="img" aria-label="Customer">
      <circle cx="100" cy="100" r="92" fill="var(--wash)" />
      <circle cx="100" cy="82" r="34" fill="var(--ledger)" opacity=".2" />
      <path d="M40 176c8-34 30-50 60-50s52 16 60 50z" fill="var(--ledger)" opacity=".2" />
      <text x="100" y="118" textAnchor="middle" fill="var(--ledger)" fontSize="72" fontWeight="700" fontFamily="system-ui, sans-serif">
        {initial}
      </text>
    </svg>
  );
}

/* ===========================================================================
   content.js me  art: "..."  me ye naam daal sakte ho
   =========================================================================== */
export default function Art({ name, initial }) {
  switch (name) {
    case "pc":
      return <PcArt />;
    case "invoice":
      return <InvoiceArt />;
    case "pos":
      return <PosArt />;
    case "themes":
      return <ThemesArt />;
    case "payments":
      return <PaymentsArt />;
    case "windows":
      return <WindowsArt />;
    case "mac":
      return <MacArt />;
    case "printer":
      return <PrinterArt />;
    case "report":
      return <ReportArt />;
    case "fields":
      return <FieldsArt />;
    case "sync":
      return <SyncArt />;
    case "whatsapp":
      return <WhatsappArt />;
    case "cash":
      return <CashArt />;
    case "stock":
      return <StockArt />;
    case "orders":
      return <OrdersArt />;
    case "play":
      return <PlayArt />;
    case "avatar":
      return <AvatarArt initial={initial} />;
    default:
      return <PcArt />;
  }
}
