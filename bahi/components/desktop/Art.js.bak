// ===========================================================================
// DESKTOP PAGE ARTWORK
// ---------------------------------------------------------------------------
// Ye saari drawings code se bani hain (SVG), photo nahi. Site ke hi colour
// tokens use karti hain isliye theme se match karti hain aur har screen par
// saaf dikhti hain.
//
// content.js me har jagah  art: "..."  likha hai. Wahi naam yahan se drawing
// uthata hai. Poori list sabse neeche Art() me hai.
//
// Asli screenshot lagana ho to content.js me us jagah ka  img: "/x.png"
// bhar do - drawing apne aap hat jayegi.
// ===========================================================================

/* --- chhote helper ---------------------------------------------------- */

// Monitor ka frame. Andar jo bhi children do, screen par aa jaate hain.
function Monitor({ children }) {
  return (
    <>
      <rect x="54" y="34" width="266" height="172" rx="12" fill="#fff" stroke="var(--ink)" strokeWidth="3" />
      <rect x="68" y="48" width="238" height="144" rx="6" fill="var(--wash)" />
      <path d="M160 206h54v22h-54z" fill="#fff" stroke="var(--ink)" strokeWidth="3" />
      <path d="M124 232h126" stroke="var(--ink)" strokeWidth="6" strokeLinecap="round" />
      <g>{children}</g>
    </>
  );
}

function Lines({ x, y, widths, gap = 18, color = "var(--ledger)", w = 6 }) {
  return (
    <g stroke={color} strokeWidth={w} strokeLinecap="round">
      {widths.map((len, i) => (
        <path key={i} d={`M${x} ${y + i * gap}h${len}`} />
      ))}
    </g>
  );
}

/* --- 1. Desktop app (hero) -------------------------------------------- */
export function PcArt() {
  return (
    <svg className="art" viewBox="0 0 420 300" role="img" aria-label="Galla billing app on a computer">
      <circle className="art__blob" cx="356" cy="64" r="52" fill="var(--wash)" />
      <Monitor>
        <rect x="68" y="48" width="238" height="26" rx="6" fill="var(--ledger)" />
        <circle cx="82" cy="61" r="4" fill="#fff" opacity=".8" />
        <circle cx="95" cy="61" r="4" fill="#fff" opacity=".5" />
        <rect x="80" y="86" width="60" height="94" rx="6" fill="#fff" />
        <Lines x={90} y={100} widths={[38, 30, 38, 26]} gap={16} w={5} color="var(--ink)" />
        <rect x="150" y="86" width="146" height="94" rx="6" fill="#fff" />
        <Lines x={162} y={102} widths={[84, 110, 70]} gap={20} />
        <rect x="162" y="158" width="66" height="14" rx="7" fill="var(--marigold)" />
      </Monitor>
      <g className="art__float">
        <circle cx="336" cy="176" r="30" fill="var(--ledger)" />
        <path d="M323 176l8 9 17-18" fill="none" stroke="#fff" strokeWidth="5" strokeLinecap="round" strokeLinejoin="round" />
      </g>
      <circle className="art__pulse" cx="336" cy="176" r="11" fill="var(--marigold)" />
    </svg>
  );
}

