// ===========================================================================
// SECTION 1  -  HERO + REGISTRATION FORM
// Heading: "Become a Galla Partner"
// Form ka code alag file me hai -> PartnerForm.js
// IMAGE: koi nahi (form hi right side par hai)
// ===========================================================================

import PartnerForm from "./PartnerForm";

export default function HeroBecomeAGallaPartner({ hero }) {
  return (
    <section className="hero pt-hero">
      <div className="wrap">
        <p className="pt-crumb">
          {hero.crumb.map((c, i) => (
            <span key={c}>
              {i > 0 && <em aria-hidden="true"> › </em>}
              {c}
            </span>
          ))}
        </p>

        <div className="pt-hero__grid">
          <div className="pt-hero__copy">
            <span className="pill">{hero.badge}</span>
            <h1>{hero.h1}</h1>
            <p className="pt-hero__h2">{hero.h2}</p>
            <p className="lead">{hero.lead}</p>

            <div className="pt-chips">
              {hero.chips.map((c, i) => (
                <span key={c} style={{ animationDelay: `${i * 120}ms` }}>
                  {c}
                </span>
              ))}
            </div>

            <ul className="pt-ticks">
              {hero.ticks.map((t) => (
                <li key={t}>{t}</li>
              ))}
            </ul>
          </div>

          <div className="pt-hero__form">
            <PartnerForm form={hero.form} />
          </div>
        </div>
      </div>
    </section>
  );
}
